{
  "name": "@rocket/server",
  "version": "0.11.2",
  "description": "Standalone headless Rocket server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "rocket-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Rocket",
    "email": "support@rocket.app"
  },
  "license": "Apache-2.0",
  "homepage": "https://agents.rocket.app",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rocket/core": "workspace:*",
    "@rocket/messaging-gateway": "workspace:*",
    "@rocket/server-core": "workspace:*",
    "@rocket/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
